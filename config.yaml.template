# ContribAI configuration reference
# Generated by `contribai init`. Prefer environment variables for secrets.

locale: en

github:
  token: ""
  token_encrypted: null
  api_base: null               # GHES API base override; default api.github.com
  rate_limit_buffer: 100
  max_prs_per_day: 2

llm:
  provider: gemini
  api_key: ""
  model: gemini-3-flash-preview
  small_model: null
  temperature: 0.2
  max_tokens: 65536
  base_url: null
  vertex_project: ""
  vertex_location: global
  cache_enabled: true
  cache_ttl_days: 7
  copilot: false
  fallback: []

analysis:
  enabled_analyzers:
    - security
    - code_quality
    - performance
  max_file_size_kb: 100
  max_context_tokens: 30000
  skip_patterns:
    - "*.min.js"
    - "*.min.css"
    - "vendor/**"
    - "node_modules/**"

contribution:
  max_changes_per_pr: 3
  sign_off: false
  commit_convention: conventional
  pr_style: descriptive
  sign_commits: false
  max_pr_body_length: 4000
  include_tests: true

discovery:
  languages: [rust, python, typescript, go]
  stars_min: 50
  stars_max: 10000
  max_results: 5
  watchlist: []

pipeline:
  dry_run: true
  agent_mode: plan
  max_retries: 2
  min_quality_score: 0.7
  max_repos_per_run: 5
  max_concurrent_repos: 2
  risk_tolerance: low
  skip_docs_prs: true
  require_bug_verification: true
  skip_repos_with_open_pr: true
  circuit_breaker_failure_threshold: 5
  circuit_breaker_success_threshold: 2
  circuit_breaker_cooldown_secs: 300
  permissions:
    file_read:
      rules: [{ pattern: "*", action: Allow }]
    file_edit:
      rules: [{ pattern: "*", action: Ask }]
    file_create:
      rules: [{ pattern: "*", action: Ask }]
    file_delete:
      rules: [{ pattern: "*", action: Deny }]
    shell_command:
      rules: [{ pattern: "*", action: Deny }]
    pr_create:
      rules: [{ pattern: "*", action: Ask }]

storage:
  db_path: "~/.contribai/memory.db"

# Contribution Runs (v7). Local execution only — submission always
# requires the per-invocation `--submit` capability grant.
run:
  runs_root: ""
  run_ttl_seconds: 7200
  max_repair_iterations: 2
  command_timeout_secs: 120
  allow_approval_commands: false
  snapshot_file_limit: 200

multi_model:
  enabled: false
  strategy: cost_optimized

scheduler:
  enabled: false
  cron: "0 */6 * * *"

quotas:
  github_daily: 1000
  llm_daily: 500
  llm_tokens_daily: 1000000

notifications:
  slack_webhook: null
  discord_webhook: null
  telegram_token: null
  telegram_chat_id: null

sandbox:
  enabled: true
  mode: local
  docker_image: null
  timeout_seconds: 30
  require_validation: true
  lsp_enabled: false
  lsp_timeout_secs: 10
  lsp_accept_warnings: false

web:
  api_keys: []
  webhook_secret: null
  tls_enabled: false
  tls_cert_path: null
  tls_key_path: null

# The read-only harness uses only this file's llm section and explicit --file inputs.
# See docs/AGENT_HARNESS.md for local Ollama setup and per-run resource limits.
plugins: []

enterprise:
  enabled: false
  sso_url: null
  audit_log_path: null
  max_daily_cost_usd: 100.0
  allowed_providers: []
